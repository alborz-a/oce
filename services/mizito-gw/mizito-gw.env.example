# copy to /etc/mizito-gw.env (root:root 600). No secrets are needed: user tokens are forwarded per request.
OCE_BASE=http://127.0.0.1:8080
PORT=18090
HOST=127.0.0.1
MIZITO_BASE_PATH=/_rs
LABEL_ROLES=owner,manager
MIZITO_COVER_DIR=/opt/mizito-gw/covers   # project covers <oce_project_id>.<ext>; outside the code dir so deploys keep it (interim until OCE GET picture route, RSD-1.4)

# Hide synthetic Mizito-import tasks (album/pilot sources, title «گفتگوی پروژه») from lists, counts, progress. Default on; 0 disables. OCE data untouched.
MIZITO_HIDE_SYNTHETIC_TASKS=1
# Company room members (OCE user uuids, comma list). Empty = every visible colleague. Company room title: MIZITO_COMPANY_TITLE.
MIZITO_COMPANY_MEMBERS=
