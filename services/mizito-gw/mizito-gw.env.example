# copy to /etc/mizito-gw.env (root:root 600). No secrets are needed: user tokens are forwarded per request.
OCE_BASE=http://127.0.0.1:8080
PORT=18090
HOST=127.0.0.1
MIZITO_BASE_PATH=/_rs
LABEL_ROLES=owner,manager
MIZITO_COVER_DIR=/opt/mizito-gw/covers   # project covers <oce_project_id>.<ext>; outside the code dir so deploys keep it (interim until OCE GET picture route, RSD-1.4)

# Hide synthetic Mizito-import tasks (album/pilot sources, title «گفتگوی پروژه») from lists, counts, progress. Default on; 0 disables. OCE data untouched.
MIZITO_HIDE_SYNTHETIC_TASKS=1
# Company room members (OCE user uuids, comma list). Empty = every visible colleague. Company room title: MIZITO_COMPANY_TITLE.
MIZITO_COMPANY_MEMBERS=
# Deleted-sender display names for imported letters: JSON {letterHex: name}. Empty = off.
MIZITO_LETTER_SENDERS=
# Hide OCE-only test tasks (TEST-PARITY, TEST-DELETE-ME, آزمون دسترسی —). 0 = show.
MIZITO_HIDE_TEST_TASKS=1
# Stored old-Mizito snapshots (notes/CRM/monitoring). Dir with *.json (not in git); notes only for MIZITO_DATA_OWNER (OCE user uuid), rest manager only.
MIZITO_DATA_DIR=
MIZITO_DATA_OWNER=
# Private room gate: comma list of OCE room ids hidden from non-admin callers (chat list, history, send, realtime, project chat link, company merge, /cdn ph-/dl- files). Default = c245187c-56c0-4d5e-9a0c-391cbd7f4a19 when unset; empty string = gate off.
MIZITO_HIDE_PRIVATE_ROOM_IDS=c245187c-56c0-4d5e-9a0c-391cbd7f4a19
# OCE user roles that still see hidden rooms (real OCE user roles: admin, manager, editor, viewer; owner kept for parity). Unknown role = hidden.
MIZITO_PRIVATE_ROOM_ADMIN_ROLES=admin,owner
