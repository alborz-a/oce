[Unit]
Description=mizito-gw (Mizito frontend on OCE)
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=nobody
WorkingDirectory=/opt/mizito-gw/mizito-gw
EnvironmentFile=/etc/mizito-gw.env
ExecStart=/usr/local/bin/node server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
